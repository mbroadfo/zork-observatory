# Copy to `.env` and fill in. Docker Compose reads it automatically; `.env`
# itself is gitignored, so a key put there never reaches a commit.
#
# Only the `claude` player needs any of this. The local models, the random and
# scripted baselines, human play and every replay work with this file absent.

# An Anthropic API key — https://console.anthropic.com/settings/keys
# This is metered usage, separate from any Claude subscription.
ANTHROPIC_API_KEY=

# Instead of a key: an OAuth bearer token, or a gateway standing in for the
# API. The SDK honours either on its own; leave them blank unless you use one.
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=

# Where the observatory looks for a local model server. The default is the
# `ollama` service in docker-compose.yml; point it at the host instead to use
# an Ollama you already run there.
# OLLAMA_HOST=http://host.docker.internal:11434
